<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>UnitTestEx</RootNamespace>
    <Product>UnitTestEx</Product>
    <Title>UnitTestEx Aspire Multi-Host Test Extensions.</Title>
    <Description>UnitTestEx .NET Aspire distributed-application (multi-host) Test Extensions.</Description>
    <PackageTags>unittestex aspire distributed multi-host unit test unittest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.4" />
    <PackageReference Include="WireMock.Net.RestClient" Version="2.18.0" />
    <!-- WireMock.Net.Shared transitively pulls Humanizer 2.14.1 (which pins Humanizer.Core and every locale sub-package to exactly 2.14.1), conflicting with Aspire.Hosting's own
         Humanizer.Core 3.0.10 - pinning the top-level Humanizer package directly (rather than Humanizer.Core) resolves the NU1608 warning, since it replaces the whole 2.14.1
         dependency subtree (Handlebars.Net.Helpers.Humanizer, the only consumer of Humanizer in this graph, isn't exercised by JsonElementComparerMatcher, so the version bump has no
         functional effect on us). -->
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="WireMock.Net.Shared" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnitTestEx\UnitTestEx.csproj" />
  </ItemGroup>

  <Import Project="..\..\Common.targets" />

</Project>
