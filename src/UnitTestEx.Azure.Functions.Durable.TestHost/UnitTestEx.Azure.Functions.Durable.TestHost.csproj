<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UnitTestEx</RootNamespace>
    <Product>UnitTestEx</Product>
    <Title>UnitTestEx Azure Functions Durable Test Host Extensions.</Title>
    <Description>Experimental FunctionTester integration and diagnostics for the in-memory Durable Task test host.</Description>
    <PackageTags>unittestex azure functions durable test host</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DurableTask.InProcessTestHost" Version="0.2.3-preview.1" />
    <ProjectReference Include="..\UnitTestEx.Azure.Functions\UnitTestEx.Azure.Functions.csproj" />
  </ItemGroup>

  <Import Project="..\..\Common.targets" />

  <PropertyGroup>
    <AssemblyOriginatorKeyFile>..\UnitTestEx\strong-name-key.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
