<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UnitTestEx</RootNamespace>
    <Product>UnitTestEx</Product>
    <Title>UnitTestEx Azure Functions Durable Testing Extensions.</Title>
    <Description>Preview fluent FunctionTester integration, activity mocks and diagnostics for the in-memory Durable Task test host, plus a separate method-level virtual-time context.</Description>
    <PackageTags>unittestex azure functions durable testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DurableTask.Abstractions" Version="1.28.0" />
    <PackageReference Include="Microsoft.DurableTask.InProcessTestHost" Version="0.2.3-preview.1" />
    <ProjectReference Include="..\UnitTestEx.Azure.Functions\UnitTestEx.Azure.Functions.csproj" />
  </ItemGroup>

  <Import Project="..\..\Common.targets" />

  <PropertyGroup>
    <AssemblyOriginatorKeyFile>..\UnitTestEx\strong-name-key.snk</AssemblyOriginatorKeyFile>
    <PackageVersion>$(Version)-preview</PackageVersion>
  </PropertyGroup>

</Project>
